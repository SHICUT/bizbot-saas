# ============================================================================
# BizBot AI — Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in your values:
#   cp .env.local.example .env.local
#
# NEVER commit .env.local to git. It contains secrets.
# ============================================================================

# ─── SUPABASE ────────────────────────────────────────────────────────────────
# Get from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key-here
SUPABASE_SERVICE_ROLE_KEY=your-secret-key-here

# ─── APP ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── WHATSAPP CLOUD API ──────────────────────────────────────────────────────
# Verify token: any random string you choose for webhook verification
WHATSAPP_VERIFY_TOKEN=your-random-verify-token

# App Secret: Meta Developer Dashboard → App Settings → Basic → App Secret
# Used to validate webhook signatures (HMAC-SHA256)
WHATSAPP_APP_SECRET=your-meta-app-secret

# ─── INSTAGRAM (Optional) ────────────────────────────────────────────────────
# Uses same Meta App Secret as WhatsApp for signature validation
# Separate verify token is optional (falls back to WHATSAPP_VERIFY_TOKEN)
# INSTAGRAM_VERIFY_TOKEN=your-ig-verify-token

# ─── OPENAI ──────────────────────────────────────────────────────────────────
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key

# ─── RAZORPAY ────────────────────────────────────────────────────────────────
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ─── N8N AUTOMATIONS (Optional) ──────────────────────────────────────────────
# N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook
# N8N_WEBHOOK_SECRET=your-n8n-shared-secret

# ─── CRON SECURITY ───────────────────────────────────────────────────────────
CRON_SECRET=your-cron-secret-here
