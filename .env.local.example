# ============================================================================
# FlowNex ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in your values
# ============================================================================

# ─── SUPABASE ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxx

# ─── APP ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://FlowNex-saasnew.vercel.app

# ─── GOOGLE GEMINI AI ────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# ─── RAZORPAY (Payment Gateway) ─────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_xxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret

# ─── WHATSAPP CLOUD API ─────────────────────────────────────────────────────
# VERIFY TOKEN: A simple custom string YOU choose. Must match Meta Dashboard.
# This is NOT the access token. It's just a password for webhook verification.
# Example: FlowNex_verify_123, my-webhook-secret, etc.
WHATSAPP_VERIFY_TOKEN=FlowNex_verify_123

# APP SECRET: From Meta App Settings → Basic → App Secret
# Used to validate webhook signatures (prevents spoofing)
WHATSAPP_APP_SECRET=your-meta-app-secret

# ─── CRON ────────────────────────────────────────────────────────────────────
CRON_SECRET=your-cron-secret
