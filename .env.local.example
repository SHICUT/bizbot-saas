# ============================================================================
# BIZBOT ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in your values
# ============================================================================

# ─── SUPABASE ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxx

# ─── APP ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://bizbot-saasnew.vercel.app

# ─── GOOGLE GEMINI AI ────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# ============================================================================
# GROQ AI (Primary Provider)
# Get from: https://console.groq.com/keys
# ============================================================================
GROQ_API_KEY=gsk_your_groq_api_key_here

# ─── RAZORPAY (Payment Gateway) ─────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_xxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret

# ─── META / WHATSAPP CLOUD API ──────────────────────────────────────────────
# Meta App credentials (from Meta Developer Dashboard → Your App → Basic)
NEXT_PUBLIC_META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# Optional: Meta Login Configuration ID (for Embedded Signup customization)
# NEXT_PUBLIC_META_CONFIG_ID=your_config_id

# Webhook Verify Token: A simple custom string YOU choose. Must match Meta Dashboard.
WHATSAPP_VERIFY_TOKEN=flownex_verify_123

# App Secret: From Meta App Settings → Basic → App Secret
# Used to validate webhook signatures (X-Hub-Signature-256)
WHATSAPP_APP_SECRET=your_app_secret

# ─── CRON ────────────────────────────────────────────────────────────────────
CRON_SECRET=your-cron-secret
