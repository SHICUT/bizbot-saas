# ============================================================================
# FLOWNEX — ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in your values.
# All variables listed here are REQUIRED unless marked (optional).
# ============================================================================

# ─── SUPABASE (Required) ─────────────────────────────────────────────────────
# Get from: https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── APP (Required) ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ─── AI PROVIDERS (At least one required) ─────────────────────────────────────
# Priority: Groq → Gemini → OpenAI. Configure at least one.
# Groq (Primary — fastest): https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_key

# Gemini (Backup): https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key

# OpenAI (Fallback, optional): https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_key

# ─── WHATSAPP / META (Required for WhatsApp bot) ─────────────────────────────
# Webhook Verify Token: A custom string YOU choose. Must match Meta Dashboard.
# This is NOT the access token. It's a simple verification passphrase.
WHATSAPP_VERIFY_TOKEN=your_custom_verify_string

# App Secret: From Meta App Dashboard → Settings → Basic → App Secret
# Used to validate webhook signatures (HMAC-SHA256). Required for production.
WHATSAPP_APP_SECRET=your_meta_app_secret

# Meta App ID: From Meta Developer Dashboard → Your App
NEXT_PUBLIC_META_APP_ID=your_meta_app_id

# Meta App Secret (same as WHATSAPP_APP_SECRET in most setups)
META_APP_SECRET=your_meta_app_secret

# Meta Login Config ID (optional — for Embedded Signup customization)
# NEXT_PUBLIC_META_CONFIG_ID=your_config_id

# ─── INSTAGRAM (Optional) ────────────────────────────────────────────────────
# Only if Instagram DM integration is enabled
# INSTAGRAM_VERIFY_TOKEN=your_instagram_verify_token

# ─── RAZORPAY (Required for billing) ─────────────────────────────────────────
# Get from: https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_live_xxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Webhook Secret: Razorpay Dashboard → Webhooks → Secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ─── CRON JOBS (Required for follow-ups, automations) ────────────────────────
# A random secret string. Set the same value in Vercel Cron config.
CRON_SECRET=generate_a_random_32_char_string

# ─── N8N AUTOMATION (Optional) ───────────────────────────────────────────────
# Only if n8n workflows are configured
# N8N_WEBHOOK_URL=https://your-n8n.app.n8n.cloud/webhook/xxxxx
# N8N_WEBHOOK_SECRET=your_n8n_secret

# ─── GOOGLE CALENDAR (Optional) ──────────────────────────────────────────────
# Only if Google Calendar integration is enabled
# Get from: https://console.cloud.google.com → Credentials → OAuth 2.0
# GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_google_client_secret
# GOOGLE_REDIRECT_URI=https://your-app.vercel.app/api/integrations/google/callback
